{
  "name": "inkling2-small-standard-lora",
  "description": "thinkingmachines/Inkling-2-Small-MXFP8, TP=8, 1 replica(s) on 8 GPU(s); catalog inkling-2-small-mxfp8/standard/h200-inference-lora.json",
  "sub_job": {
    "inference_config": {
      "max_seq_len": 65536,
      "n_gpus": 8,
      "max_num_batched_tokens": 8192,
      "peft_config": {
        "peft_type": "Lora",
        "task_type": "CAUSAL_LM",
        "r": 16,
        "lora_alpha": 32,
        "lora_dropout": 0.0,
        "bias": "none",
        "target_modules": [
          "wq_du",
          "wv_dv"
        ],
        "target_parameters": [
          "experts.w1",
          "experts.w2",
          "experts.w3"
        ]
      },
      "router_replay": {
        "enabled": false
      },
      "vllm_config": {
        "tensor_parallel_size": 8,
        "max_num_seqs": 32,
        "gpu_memory_utilization": 0.8,
        "enable_chunked_prefill": true,
        "reasoning_parser": "inkling",
        "tool_call_parser": "inkling",
        "extra_engine_kwargs": {
          "tokenizer_mode": "inkling",
          "dtype": "bfloat16",
          "kernel_config": {
            "enable_flashinfer_autotune": false
          },
          "enable_prefix_caching": false
        }
      }
    },
    "job_type": "sampling",
    "model_name": "thinkingmachines/Inkling-2-Small-MXFP8"
  }
}
