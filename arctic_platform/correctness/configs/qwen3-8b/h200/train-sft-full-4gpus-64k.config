{
  "model_name": "Qwen/Qwen3-8B",
  "seed": 42,
  "dtype": "bfloat16",
  "max_seq_len": 32768,
  "training_gpus": 4,
  "sampling_gpus": 0,
  "log_prob_gpus": 0,
  "training": {
    "ds_config": {
      "train_batch_size": 4,
      "train_micro_batch_size_per_gpu": 1,
      "gradient_accumulation_steps": 1,
      "zero_optimization": {
        "stage": 2
      },
      "bf16": {
        "enabled": true
      },
      "gradient_clipping": 1.0,
      "optimizer": {
        "type": "AdamW",
        "params": {
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08
        }
      }
    },
    "ds_worker_config": {
      "model_provider": "huggingface",
      "attn_implementation": "flash_attention_3",
      "activation_checkpointing": true
    }
  },
  "sampling": {},
  "backend": {
    "type": "onprem",
    "protocol": "ray"
  }
}
