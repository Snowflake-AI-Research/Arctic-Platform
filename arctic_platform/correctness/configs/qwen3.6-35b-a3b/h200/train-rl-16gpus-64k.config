{
  "model_name": "Qwen/Qwen3.6-35B-A3B",
  "seed": 42,
  "dtype": "bfloat16",
  "max_seq_len": 32768,
  "training_gpus": 8,
  "sampling_gpus": 8,
  "log_prob_gpus": 0,
  "training": {
    "ds_config": {
      "bf16": {
        "enabled": true
      },
      "gradient_accumulation_steps": 1,
      "train_batch_size": 8,
      "train_micro_batch_size_per_gpu": 1,
      "zero_optimization": {
        "reduce_scatter": true,
        "stage": 1
      },
      "gradient_clipping": 1,
      "optimizer": {
        "type": "AdamW",
        "params": {
          "betas": [
            0.9,
            0.999
          ],
          "eps": 1e-08,
          "lr": 0.0001,
          "weight_decay": 0
        }
      }
    },
    "ds_worker_config": {
      "ac_config": {
        "freq": 1,
        "mode": "full"
      },
      "attn_impl": "flash_attention_3",
      "attn_implementation": "flash_attention_3",
      "ep_size": 4,
      "mb_spec": {
        "max_tokens_per_mb": 10240
      },
      "model_provider": "prime_rl",
      "prime_rl": {
        "fused_cross_entropy": false,
        "fused_lm_head_token_chunk_size": 8192
      }
    }
  },
  "sampling": {
    "vllm": {
      "gpu_memory_utilization": 0.8,
      "tensor_parallel_size": 8
    },
    "arctic_inference_config": {
      "router_replay": {
        "enabled": true
      }
    }
  },
  "backend": {
    "type": "onprem",
    "protocol": "ray"
  }
}
