{
  "model_name": "Qwen/Qwen3.8-Flash-Next",
  "dtype": "bfloat16",
  "seed": 42,
  "max_seq_len": 262144,
  "training_gpus": 16,
  "sampling_gpus": 16,
  "log_prob_gpus": 0,
  "training": {
    "weight_format": "vllm",
    "ds_config": {
      "train_batch_size": 1,
      "train_micro_batch_size_per_gpu": 1,
      "gradient_accumulation_steps": 1,
      "gradient_clipping": 1.0,
      "optimizer": {
        "type": "AdamW",
        "params": {
          "lr": 2e-05,
          "weight_decay": 0.0,
          "betas": [0.9, 0.999],
          "eps": 1e-08
        }
      },
      "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
          "device": "cpu",
          "pin_memory": false
        }
      },
      "bf16": {
        "enabled": true
      }
    },
    "ds_worker_config": {
      "model_provider": "prime_rl",
      "attn_implementation": "qsa_flex",
      "cuda_allocator_conf": "expandable_segments:True",
      "activation_checkpointing": true,
      "sp_size": 16,
      "ep_size": 8,
      "ep_group_layout": "auto",
      "mb_spec": {
        "max_tokens_per_mb": 262144
      },
      "ac_config": {
        "mode": "full",
        "freq": 1,
        "router_replay_recompute": true,
        "offload_config": {
          "enabled": true,
          "keep_last_n": 1,
          "use_streams": true,
          "pin_memory_enabled": true,
          "pin_memory_max_size_gib": "auto",
          "pin_memory_bucket_size_mib": 64
        }
      },
      "step_peak_memory_log": true,
      "router_replay": {
        "enabled": true,
        "max_cache_bytes": 2147483648
      },
      "prime_rl": {
        "fused_cross_entropy": false,
        "seq_len": 262144
      },
      "fused_lm_head_token_chunk_size": 1024,
      "fused_lm_head_vocab_chunk_size": 8192
    }
  },
  "sampling": {
    "weight_format": "vllm",
    "vllm": {
      "tensor_parallel_size": 8,
      "trust_remote_code": true,
      "gpu_memory_utilization": 0.9,
      "max_num_seqs": 16,
      "distributed_executor_backend": "mp",
      "enable_chunked_prefill": true,
      "max_num_batched_tokens": 8192,
      "enforce_eager": false,
      "enable_return_routed_experts": true,
      "enable_prefix_caching": true,
      "gdn_prefill_backend": "triton",
      "reasoning_parser": "qwen3",
      "extra_engine_kwargs": {
        "disable_custom_all_reduce": true
      }
    },
    "arctic_inference_config": {
      "num_replicas": 2,
      "router_replay": {
        "enabled": true,
        "max_cache_bytes": 17179869184
      }
    }
  },
  "backend": {
    "type": "remote",
    "protocol": "cortex",
    "base_url": "http://127.0.0.1:8003",
    "database": "dev",
    "schema": "dev"
  }
}
