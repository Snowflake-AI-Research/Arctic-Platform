{
  "profiles": [
    {
      "id": "dense-rl-lora-8x8",
      "workflow": "rl",
      "tuningMethod": "lora",
      "summary": "LoRA RL starting point with eight training and eight sampling GPUs.",
      "recipePath": "cortex-client/recipes/rl_loop.py",
      "evidencePaths": [
        "cortex-client/recipes/rl_loop.py"
      ],
      "subJobs": [
        {
          "builder": "training_job",
          "args": {
            "optimizer": {
              "name": "AdamW",
              "lr": 0.00002,
              "weight_decay": 0.0,
              "betas": [0.9, 0.95],
              "eps": 1e-8
            },
            "max_seq_len": 8192,
            "train_batch_size": 8,
            "n_gpus": 8,
            "gradient_clipping": 1.0,
            "dtype": "bfloat16",
            "seed": 42,
            "extra_training": {
              "attn_implementation": "flash_attention_3",
              "mb_spec": {
                "max_tokens_per_mb": 10240
              },
              "peft_config": {
                "peft_type": "Lora",
                "r": 32,
                "lora_alpha": 32,
                "lora_dropout": 0.0,
                "bias": "none",
                "target_modules": [
                  "q_proj",
                  "k_proj",
                  "v_proj",
                  "o_proj",
                  "gate_proj",
                  "up_proj",
                  "down_proj"
                ]
              },
              "ds_config": {
                "train_batch_size": 8,
                "train_micro_batch_size_per_gpu": 1,
                "gradient_accumulation_steps": 1,
                "zero_optimization": {
                  "stage": 2,
                  "reduce_scatter": true
                },
                "bf16": {
                  "enabled": true
                }
              }
            }
          }
        },
        {
          "builder": "sampling_job",
          "args": {
            "max_seq_len": 8192,
            "n_gpus": 8,
            "dtype": "bfloat16",
            "seed": 42,
            "extra_sampling": {
              "peft_config": {
                "peft_type": "Lora",
                "r": 32,
                "lora_alpha": 32,
                "lora_dropout": 0.0,
                "bias": "none",
                "target_modules": [
                  "q_proj",
                  "k_proj",
